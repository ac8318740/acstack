# >>> acstack project-data >>>
!/.acstack/
/.acstack/**
# <<< acstack project-data <<<

# This repository opts into tracking its ACStack project data.
!/.acstack/
!/.acstack/**

# The CLI test run writes a vitest cache here, and `pi install` runs npm install at the root.
node_modules/

# `acstack config set` writes its replacement beside the file and renames over
# it. The cleanup runs on a thrown error, so only a killed process leaves one.
acstack/*.tmp
