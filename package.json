{
  "name": "acstack",
  "version": "0.57.11",
  "private": false,
  "description": "Agentic coding stack for Claude Code, Codex, and pi: skills, orchestrator instructions, CLI, and verification agents.",
  "scripts": {
    "prepack": "npm --prefix cli run build && node scripts/gen-codex-agents.mjs && node scripts/gen-pi-agents.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ac8318740/acstack.git"
  },
  "keywords": [
    "pi-package",
    "acstack",
    "tdd",
    "agentic-coding",
    "agent-orchestration"
  ],
  "bin": {
    "acstack": "./cli/bin/acstack.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    ".claude-plugin/",
    "agents/",
    "assets/",
    "cli/bin/",
    "cli/dist/",
    "cli/package.json",
    "cli/README.md",
    "docs/",
    "examples/design-doc/",
    "hooks/",
    "orchestrator/",
    "output-styles/",
    "pi/",
    "profiles/",
    "skills/",
    "THIRD_PARTY_NOTICES",
    "TROUBLESHOOTING.md"
  ],
  "pi": {
    "extensions": [
      "./pi/extension.ts",
      "./assets/terminal-workspace/pi/acstack-question-blocked.ts"
    ],
    "subagents": {
      "agents": [
        "./pi/agents"
      ]
    }
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  }
}
